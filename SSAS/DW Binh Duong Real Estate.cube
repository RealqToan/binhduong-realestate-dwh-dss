  <MdxScripts>
    <MdxScript dwd:design-time-name="162c46b1-1ed7-4a59-829b-a9d7e9f46ff1">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Avg_Price_Per_m2
 AS IIF([Measures].[Area] = 0, NULL, [Measures].[Price] / [Measures].[Area]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Avg_Listing_Price
 AS IIF([Measures].[Total Listings] = 0, NULL, [Measures].[Price] / [Measures].[Total Listings]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>