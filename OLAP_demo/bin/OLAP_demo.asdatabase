      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Price_Per_M2
 AS IIF(
    [Measures].[Area] = 0,
    NULL,
    [Measures].[Price] / [Measures].[Area]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Supply_Share_Pc
 AS IIF(
    [Measures].[Fact Listing Count] = 0,
    NULL,
    [Measures].[Fact Listing Count]
    /
    (
        [Measures].[Fact Listing Count],
        [Dim Segment].[Segment Name].DefaultMember
    )
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Price_Growth_MoM
 AS IIF(
    IsEmpty(
        (
            [Measures].[Price Per M2],
            ParallelPeriod(
                [Dim Date].[Calendar].[Month],
                1,
                [Dim Date].[Calendar].CurrentMember
            )
        )
    )
    OR
    (
        [Measures].[Price Per M2],
        ParallelPeriod(
            [Dim Date].[Calendar].[Month],
            1,
            [Dim Date].[Calendar].CurrentMember
        )
    ) = 0,

    NULL,

    (
        [Measures].[Price Per M2]
        -
        (
            [Measures].[Price Per M2],
            ParallelPeriod(
                [Dim Date].[Calendar].[Month],
                1,
                [Dim Date].[Calendar].CurrentMember
            )
        )
    )
    /
    (
        [Measures].[Price Per M2],
        ParallelPeriod(
            [Dim Date].[Calendar].[Month],
            1,
            [Dim Date].[Calendar].CurrentMember
        )
    )
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
