                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">([ISNULL](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[price]}) || [ISNULL](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[area]}) || #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[area]} == 0) ? NULL(DT_NUMERIC,18,2) : (DT_NUMERIC,18,2)(#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[price]} / #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[area]})</property>
