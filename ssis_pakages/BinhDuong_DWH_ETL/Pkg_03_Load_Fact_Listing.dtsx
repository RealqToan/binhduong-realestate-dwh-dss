                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(ISNULL(price) || ISNULL(area) || area == 0) ? NULL(DT_NUMERIC,18,2) : (DT_NUMERIC,18,2)(price / area)</property>
