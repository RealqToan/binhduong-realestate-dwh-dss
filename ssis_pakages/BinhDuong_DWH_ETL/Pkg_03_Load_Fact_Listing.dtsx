              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
   staging_id, name, price, area, price_per_m2, frontage_width, 
    district_name, ward_name, street_name, project_name, 
    property_type_name, house_direction, full_date, post_hour, is_outlier,
    CAST(CASE 
        WHEN price IS NULL OR price &lt; 2000000000 THEN N'Giá rẻ'
        WHEN price &lt;= 5000000000 THEN N'Trung cấp'
        ELSE N'Cao cấp'
    END AS NVARCHAR(50)) AS price_segment,
    CAST(CASE 
        WHEN area IS NULL OR area &lt; 50 THEN N'Nhỏ'
        WHEN area &lt;= 100 THEN N'Vừa'
        ELSE N'Lớn'
    END AS NVARCHAR(50)) AS area_segment,
    CAST(CASE 
        WHEN frontage_width IS NULL OR frontage_width &lt; 4 THEN N'Hẹp'
        WHEN frontage_width &lt;= 8 THEN N'Tiêu chuẩn'
        ELSE N'Rộng'
    END AS NVARCHAR(50)) AS frontage_segment
FROM dbo.Staging_Listings;</property>
