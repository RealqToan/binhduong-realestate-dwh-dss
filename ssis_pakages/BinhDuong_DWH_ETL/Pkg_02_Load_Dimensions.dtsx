      DTS:ObjectName="Dim_Location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{17B5B4D8-E28E-45B0-8BDB-847EFC433835}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Dim_Location (province_name, district_name, ward_name, street_name)&#xA;SELECT DISTINCT &#xA;    ISNULL(province_name, N'Bình Dương') AS province_name, &#xA;    ISNULL(district_name, N'Chưa xác định') AS district_name, &#xA;    ISNULL(ward_name, N'Chưa xác định') AS ward_name, &#xA;    ISNULL(street_name, N'Chưa xác định') AS street_name&#xA;FROM dbo.BinhDuong_Staging&#xA;WHERE district_name IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Dim_Project"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6E3B728A-A285-4433-80C9-1C2732E60E18}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Dim_Project"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{17B5B4D8-E28E-45B0-8BDB-847EFC433835}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Dim_Project (project_name)&#xA;SELECT DISTINCT &#xA;    project_name&#xA;FROM dbo.BinhDuong_Staging &#xA;WHERE project_name IS NOT NULL &#xA;  AND LTRIM(RTRIM(project_name)) &lt;&gt; '';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Dim_PropertyType"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FF9C2EC1-7009-4070-AF52-A0BB3C7FC1A4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Dim_PropertyType"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{17B5B4D8-E28E-45B0-8BDB-847EFC433835}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Dim_PropertyType (property_type_name)&#xA;SELECT DISTINCT &#xA;    ISNULL(property_type_name, N'Khác') AS property_type_name&#xA;FROM dbo.BinhDuong_Staging&#xA;WHERE property_type_name IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
