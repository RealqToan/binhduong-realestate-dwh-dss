                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    CAST(CONVERT(VARCHAR(8), full_date, 112) AS INT) AS date_key,
    full_date,
    DAY(full_date) AS day_of_month,
    DATEPART(WEEKDAY, full_date) AS day_of_week,
    DATENAME(WEEKDAY, full_date) AS day_name,
    DATEPART(WEEK, full_date) AS week_of_year,
    MONTH(full_date) AS month_num,
    DATENAME(MONTH, full_date) AS month_name,
    DATEPART(QUARTER, full_date) AS quarter,
    YEAR(full_date) AS year_num,
    CASE WHEN DATEPART(WEEKDAY, full_date) IN (1, 7) THEN 1 ELSE 0 END AS is_weekend
FROM dbo.Staging_Listings
WHERE full_date IS NOT NULL;</property>
