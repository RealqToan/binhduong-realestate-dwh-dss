                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(post_hour AS INT) AS time_key,
    CAST(post_hour AS INT) AS hour,
    CAST(CASE 
        WHEN post_hour BETWEEN 0 AND 5 THEN N'Ban đêm'
        WHEN post_hour BETWEEN 6 AND 11 THEN N'Buổi sáng'
        WHEN post_hour BETWEEN 12 AND 17 THEN N'Buổi chiều'
        ELSE N'Buổi tối'
    END AS NVARCHAR(10)) AS day_period
FROM dbo.Staging_Listings
WHERE post_hour IS NOT NULL;</property>
