        <SQLTask:SqlTaskData
          SQLTask:Connection="{19D56D6F-49DD-4B1C-B6E0-A56B70E2AED2}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Segment)&#xA;BEGIN&#xA;    INSERT INTO dbo.Dim_Segment (price_segment, area_segment, frontage_segment)&#xA;    SELECT p.price_segment, a.area_segment, f.frontage_segment&#xA;    FROM (VALUES (N'Giá rẻ'), (N'Trung cấp'), (N'Cao cấp')) AS p(price_segment)&#xA;    CROSS JOIN (VALUES (N'Nhỏ'), (N'Vừa'), (N'Lớn')) AS a(area_segment)&#xA;    CROSS JOIN (VALUES (N'Hẹp'), (N'Tiêu chuẩn'), (N'Rộng')) AS f(frontage_segment);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
