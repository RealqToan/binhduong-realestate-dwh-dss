            <component
              refId="Package\DFT_Load_Fact_Listing\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.stg_row_id,
    COALESCE(CONVERT(INT, CONVERT(CHAR(8), s.full_date, 112)), -1) AS date_key,
    COALESCE(CAST(s.post_hour AS INT), -1)                         AS time_key,
    COALESCE(l.location_key, -1)                                   AS location_key,
    COALESCE(pt.property_type_key, -1)                             AS property_type_key,
    CASE WHEN s.project_name = N'Không thuộc dự án' THEN 0
         WHEN s.project_name = N'Không xác định'    THEN -1
         ELSE COALESCE(pr.project_key, -1) END                     AS project_key,
    COALESCE(d.direction_key, -1)                                  AS direction_key,
    COALESCE(CAST(s.segment_key AS INT), -1)                       AS segment_key,
    s.price,
    s.area,
    s.frontage_width,
    CAST(s.bedroom_count  AS TINYINT) AS bedroom_count,
    CAST(s.bathroom_count AS TINYINT) AS bathroom_count,
    CAST(1 AS TINYINT)                AS total_listings,
    s.is_outlier
FROM BinhDuong_Staging.dbo.Stg_Listing AS s
LEFT JOIN BDS_DW.dbo.Dim_Location     AS l  ON l.province_name = s.province_name
                                           AND l.district_name = s.district_name
                                           AND l.ward_name     = s.ward_name
                                           AND l.street_name   = s.street_name
LEFT JOIN BDS_DW.dbo.Dim_PropertyType AS pt ON pt.property_type_name = s.property_type_name
LEFT JOIN BDS_DW.dbo.Dim_Project      AS pr ON pr.project_name = s.project_name
LEFT JOIN BDS_DW.dbo.Dim_Direction    AS d  ON d.house_direction = s.house_direction;</property>
