    <DTS:Executable
      DTS:refId="Package\SQL_Clear_Warehouse"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FA74752D-1F87-4D85-8818-C7D2BAFFF448}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Clear_Warehouse"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{785A4B95-AAE5-4C9E-864E-8BE1C8C5536F}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.Fact_Listing_Detail;&#xA;DELETE FROM dbo.Fact_Listing;&#xA;DBCC CHECKIDENT ('dbo.Fact_Listing', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_Dim_Location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{669DA7F0-1DB3-488E-AC74-805C892854FD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_Dim_Location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{785A4B95-AAE5-4C9E-864E-8BE1C8C5536F}"
          SQLTask:SqlStatementSource="     INSERT INTO dbo.Dim_Location (province_name, district_name, ward_name, street_name)&#xA;     SELECT DISTINCT s.province_name, s.district_name, s.ward_name, s.street_name&#xA;     FROM BinhDuong_Staging.dbo.Stg_Listing AS s&#xA;     WHERE NOT EXISTS (&#xA;         SELECT 1 FROM dbo.Dim_Location l&#xA;         WHERE l.province_name = s.province_name&#xA;           AND l.district_name = s.district_name&#xA;           AND l.ward_name     = s.ward_name&#xA;           AND l.street_name   = s.street_name&#xA;     );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_Dim_Project"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E216EC13-A293-40F1-983E-6D7848B3F90D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_Dim_Project"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{785A4B95-AAE5-4C9E-864E-8BE1C8C5536F}"
          SQLTask:SqlStatementSource="     INSERT INTO dbo.Dim_Project (project_name)&#xA;     SELECT DISTINCT s.project_name&#xA;     FROM BinhDuong_Staging.dbo.Stg_Listing AS s&#xA;     WHERE s.project_name IS NOT NULL&#xA;       AND s.project_name NOT IN (N'Không thuộc dự án', N'Không xác định')&#xA;       AND NOT EXISTS (&#xA;           SELECT 1 FROM dbo.Dim_Project p&#xA;           WHERE p.project_name = s.project_name&#xA;       );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_Fact_Detail"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D1DC4407-1BD0-4DE1-A696-6EEDA41EC70F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_Fact_Detail"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{785A4B95-AAE5-4C9E-864E-8BE1C8C5536F}"
          SQLTask:SqlStatementSource="     INSERT INTO dbo.Fact_Listing_Detail (fact_id, name, description_raw)&#xA;     SELECT f.fact_id, s.name, s.description&#xA;     FROM dbo.Fact_Listing AS f&#xA;     JOIN BinhDuong_Staging.dbo.Stg_Listing AS s&#xA;       ON s.stg_row_id = f.stg_row_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Truncate_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D83FF8C4-A53C-4C45-8BD9-0028942BDA60}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Truncate_Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7140C6A-7645-4BB2-B188-99BE3B858EC0}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.Stg_Listing;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
