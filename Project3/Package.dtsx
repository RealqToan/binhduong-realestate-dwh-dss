            <component
              refId="Package\dim_date\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CONVERT(INT,
        YEAR(s.full_date) * 10000
        + MONTH(s.full_date) * 100
        + DAY(s.full_date)
    ) AS date_key,

    s.full_date,

    DAY(s.full_date) AS day_of_month,

    ((DATEDIFF(DAY, '19000101', s.full_date) % 7) + 1)
        AS day_of_week,

    DATENAME(WEEKDAY, s.full_date) AS day_name,

    DATEPART(ISO_WEEK, s.full_date) AS week,

    MONTH(s.full_date) AS month_num,

    DATENAME(MONTH, s.full_date) AS month_name,

    DATEPART(QUARTER, s.full_date) AS quarter_num,

    CONCAT('Q', DATEPART(QUARTER, s.full_date))
        AS quarter_name,

    YEAR(s.full_date) AS year,

    CAST(
        CASE s.full_date
            WHEN '2025-01-01' THEN N'Tết Dương lịch'
            WHEN '2025-04-07' THEN N'Giỗ Tổ Hùng Vương'
            WHEN '2025-04-30' THEN N'Ngày Giải phóng miền Nam 30/4'
            WHEN '2025-05-01' THEN N'Ngày Quốc tế Lao động 1/5'
            WHEN '2025-09-02' THEN N'Ngày Quốc khánh 2/9'
            ELSE NULL
        END AS NVARCHAR(50)
    ) AS holiday_name,

    CAST(
        CASE
            WHEN s.full_date IN ('2025-01-01', '2025-04-07', '2025-04-30', '2025-05-01', '2025-09-02')
                THEN 1
            ELSE 0
        END AS BIT
    ) AS is_holiday

FROM Staging_RealEstate s

LEFT JOIN Dim_Date d
    ON s.full_date = d.full_date

WHERE s.full_date IS NOT NULL
  AND d.full_date IS NULL;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
