              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(LTRIM(RTRIM(s.province_name)) AS NVARCHAR(50))
        AS province_name,

    CAST(LTRIM(RTRIM(s.district_name)) AS NVARCHAR(50))
        AS district_name,

    CAST(LTRIM(RTRIM(s.ward_name)) AS NVARCHAR(50))
        AS ward_name,

    CAST(LTRIM(RTRIM(s.street_name)) AS NVARCHAR(100))
        AS street_name

FROM Staging_RealEstate s

WHERE NOT EXISTS
(
    SELECT 1
    FROM Dim_Location d
    WHERE ISNULL(d.province_name, N'') =
          ISNULL(LTRIM(RTRIM(s.province_name)), N'')
      AND ISNULL(d.district_name, N'') =
          ISNULL(LTRIM(RTRIM(s.district_name)), N'')
      AND ISNULL(d.ward_name, N'') =
          ISNULL(LTRIM(RTRIM(s.ward_name)), N'')
      AND ISNULL(d.street_name, N'') =
          ISNULL(LTRIM(RTRIM(s.street_name)), N'')
);</property>
