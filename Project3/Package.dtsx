    <DTS:Executable
      DTS:refId="Package\Dim_Segment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{243D08FA-8BFE-4039-9C05-D60677490DE5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Dim_Segment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E56489B0-C80E-45A7-8D62-53025755431F}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Dim_Segment (segment_key, segment_name, sort_order)&#xA;SELECT v.segment_key, v.segment_name, v.sort_order&#xA;FROM (VALUES&#xA;    (-1, N'Không xác định', 0),&#xA;    ( 1, N'Phân khúc thấp',  1),&#xA;    ( 2, N'Trung bình',     2),&#xA;    ( 3, N'Cao cấp',        3),&#xA;    ( 4, N'Rất cao',        4)&#xA;) AS v(segment_key, segment_name, sort_order)&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.Dim_Segment d&#xA;    WHERE d.segment_key = v.segment_key&#xA;);&#xA;&#xA;&#xA;DELETE FROM dbo.Cfg_Segment_Threshold WHERE version = 1;&#xA;&#xA;INSERT INTO dbo.Cfg_Segment_Threshold (version, effective_date, segment_key, min_price_per_m2, max_price_per_m2)&#xA;SELECT 1, '2025-01-01', 1, 0, q.P25 FROM (&#xA;    SELECT DISTINCT&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P25,&#xA;        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P50,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P75&#xA;    FROM dbo.Staging_RealEstate&#xA;    WHERE price &gt; 0 AND area &gt; 0 AND is_outlier = 0&#xA;) q&#xA;UNION ALL&#xA;SELECT 1, '2025-01-01', 2, q.P25, q.P50 FROM (&#xA;    SELECT DISTINCT&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P25,&#xA;        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P50,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P75&#xA;    FROM dbo.Staging_RealEstate&#xA;    WHERE price &gt; 0 AND area &gt; 0 AND is_outlier = 0&#xA;) q&#xA;UNION ALL&#xA;SELECT 1, '2025-01-01', 3, q.P50, q.P75 FROM (&#xA;    SELECT DISTINCT&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P25,&#xA;        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P50,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P75&#xA;    FROM dbo.Staging_RealEstate&#xA;    WHERE price &gt; 0 AND area &gt; 0 AND is_outlier = 0&#xA;) q&#xA;UNION ALL&#xA;SELECT 1, '2025-01-01', 4, q.P75, NULL FROM (&#xA;    SELECT DISTINCT&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P25,&#xA;        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P50,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price / NULLIF(area, 0)) OVER () AS P75&#xA;    FROM dbo.Staging_RealEstate&#xA;    WHERE price &gt; 0 AND area &gt; 0 AND is_outlier = 0&#xA;) q;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
