                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    post_hour AS time_key,
    CASE
        WHEN post_hour BETWEEN 0 AND 5
            THEN N'Đêm'
        WHEN post_hour BETWEEN 6 AND 11
            THEN N'Sáng'
        WHEN post_hour BETWEEN 12 AND 17
            THEN N'Chiều'
        WHEN post_hour BETWEEN 18 AND 23
            THEN N'Tối'
    END AS day_period
FROM dbo.Staging_RealEstate
WHERE post_hour BETWEEN 0 AND 23;</property>
