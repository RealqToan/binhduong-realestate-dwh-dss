                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(LTRIM(RTRIM(s.property_type_name)) AS NVARCHAR(50)) AS property_type_name,

    CAST(
        CASE LTRIM(RTRIM(s.property_type_name))
            WHEN N'Căn hộ chung cư'      THEN N'BĐS ở'
            WHEN N'Nhà'                  THEN N'BĐS ở'
            WHEN N'Biệt thự/Nhà liền kề' THEN N'BĐS ở'
            WHEN N'Đất'                  THEN N'BĐS đất'
            WHEN N'Shophouse'            THEN N'BĐS thương mại'
            ELSE N'Không xác định'
        END AS NVARCHAR(50)
    ) AS property_type_group

FROM dbo.Staging_RealEstate s
LEFT JOIN dbo.Dim_PropertyType d
    ON LTRIM(RTRIM(s.property_type_name)) = d.property_type_name
WHERE s.property_type_name IS NOT NULL
  AND LTRIM(RTRIM(s.property_type_name)) &lt;&gt; N''
  AND d.property_type_key IS NULL;</property>
