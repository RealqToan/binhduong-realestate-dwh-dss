            <component
              refId="Package\Dim_Direction\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Direction_Clean AS
(
    SELECT
        CAST(
            CASE
                WHEN house_direction IS NULL
                  OR LTRIM(RTRIM(house_direction)) = N''
                    THEN N'Chưa xác định'

                WHEN REPLACE(REPLACE(LTRIM(RTRIM(house_direction)), N' ', N''), N'-', N'')
                    = N'ĐôngBắc' THEN N'Đông Bắc'

                WHEN REPLACE(REPLACE(LTRIM(RTRIM(house_direction)), N' ', N''), N'-', N'')
                    = N'TâyBắc' THEN N'Tây Bắc'

                WHEN REPLACE(REPLACE(LTRIM(RTRIM(house_direction)), N' ', N''), N'-', N'')
                    = N'ĐôngNam' THEN N'Đông Nam'

                WHEN REPLACE(REPLACE(LTRIM(RTRIM(house_direction)), N' ', N''), N'-', N'')
                    = N'TâyNam' THEN N'Tây Nam'

                ELSE LTRIM(RTRIM(house_direction))
            END AS NVARCHAR(30)
        ) AS house_direction
    FROM Staging_RealEstate
),
Direction_Group AS
(
    SELECT DISTINCT
        house_direction,
        CAST(
            CASE
                WHEN house_direction IN
                    (N'Đông', N'Tây', N'Nam', N'Bắc')
                    THEN N'Hướng chính'

                WHEN house_direction IN
                    (N'Đông Bắc', N'Tây Bắc',
                     N'Đông Nam', N'Tây Nam')
                    THEN N'Hướng phụ'

                WHEN house_direction = N'Chưa xác định'
                    THEN N'Không xác định'

                ELSE N'Khác'
            END AS NVARCHAR(30)
        ) AS direction_group
    FROM Direction_Clean
)
SELECT
    d.house_direction,
    d.direction_group
FROM Direction_Group d
WHERE NOT EXISTS
(
    SELECT 1
    FROM dbo.Dim_Direction old
    WHERE old.house_direction = d.house_direction
);</property>
