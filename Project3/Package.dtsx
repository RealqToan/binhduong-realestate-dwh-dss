      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E56489B0-C80E-45A7-8D62-53025755431F}"
          SQLTask:SqlStatementSource="&#xA;USE DW_BinhDuong_RealEstate;&#xA;GO&#xA;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- 1. Xóa Fact trước&#xA;    DELETE FROM dbo.Fact_Listing_Detail;&#xA;    DELETE FROM dbo.Fact_Listing;&#xA;&#xA;    -- 2. Xóa bảng cấu hình phân khúc&#xA;    DELETE FROM dbo.Cfg_Segment_Threshold;&#xA;&#xA;    -- 3. Xóa toàn bộ Dimension&#xA;    DELETE FROM dbo.Dim_Location;&#xA;    DELETE FROM dbo.Dim_PropertyType;&#xA;    DELETE FROM dbo.Dim_Project;&#xA;    DELETE FROM dbo.Dim_Direction;&#xA;    DELETE FROM dbo.Dim_Time;&#xA;    DELETE FROM dbo.Dim_Date;&#xA;    DELETE FROM dbo.Dim_Segment;&#xA;&#xA;    -- 4. Xóa Staging&#xA;    DELETE FROM dbo.Staging_RealEstate;&#xA;&#xA;    -- 5. Reset IDENTITY&#xA;    DBCC CHECKIDENT ('dbo.Fact_Listing', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dbo.Dim_Location', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dbo.Dim_PropertyType', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dbo.Dim_Project', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dbo.Dim_Direction', RESEED, 0);&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    PRINT N'CLEAR ALL SUCCESS!';&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
